{
  "name": "vilocare-desktop",
  "productName": "ViLoCare",
  "version": "1.1.1",
  "description": "Desktop shell for the ViLoCare offline-first ART clinic system",
  "main": "src/main.js",
  "private": true,
  "author": "ViLoCare",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "make-icons": "node scripts/make-icons.js",
    "fetch-php": "node scripts/fetch-php.js",
    "prepare-app": "node scripts/prepare-app.js",
    "start": "npm run make-icons && electron .",
    "build:installer": "npm run make-icons && npm run fetch-php && npm run prepare-app && node scripts/build-installer.js && node scripts/check-build.js",
    "dist": "npm run build:installer",
    "release": "node scripts/release.js",
    "test-update-server": "node scripts/test-update-server.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
